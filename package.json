{
  "name": "dsh-codex-auth",
  "description": "One DeepSeek Harness Codex capability bundle for ChatGPT login, LLM access, Web Search, and durable Image Creation",
  "version": "0.3.3-alpha.5",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suntianc/dsh-codex-auth.git"
  },
  "homepage": "https://github.com/suntianc/dsh-codex-auth#readme",
  "bugs": {
    "url": "https://github.com/suntianc/dsh-codex-auth/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codex",
    "chatgpt",
    "oauth",
    "web-search",
    "image-generation",
    "context-compaction"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.cjs"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/search.js"
    },
    "./image": {
      "types": "./lib/types/image.d.ts",
      "default": "./lib/image.js"
    },
    "./compaction": {
      "types": "./lib/types/compaction.d.ts",
      "default": "./lib/compaction.js"
    },
    "./native-checkpoint": {
      "types": "./lib/types/native-checkpoint.d.ts",
      "default": "./lib/native-checkpoint.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/*.cjs",
    "lib/*.cjs.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "examples/agent-presets/codex-portable/*.yml",
    "docs/design.md",
    "docs/adr/*.md",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.host.json && tsc -p tsconfig.build.client.json && tsdown",
    "bundle": "tsdown",
    "check": "pnpm peers check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build && pnpm run package:smoke && pnpm run publint",
    "lint": "oxlint src tests build scripts tsdown.config.ts vitest.config.ts vitest.live.config.ts",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepare": "tsdown",
    "prepack": "pnpm run build",
    "publint": "publint",
    "test": "vitest run",
    "test:live:native-compaction": "node scripts/run-native-compaction-live.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.5",
